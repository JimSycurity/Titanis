<?xml version="1.0" encoding="utf-8"?>
<helpItems schema="maml" xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10">
  <command:command>
    <command:details>
      <command:name>Connect-TBOSmbServer</command:name>
      <command:verb>Connect</command:verb>
      <command:noun>TBOSmbServer</command:noun>
      <maml:description>
        <maml:para>Initializes the TBO.Smb2 provider for a server name. Connections are opened on demand by later cmdlets.</maml:para>
      </maml:description>
    </command:details>
    <command:syntax>
      <command:syntaxItem>
        <command:name>Connect-TBOSmbServer</command:name>
        <command:parameter required="true" position="0">
          <maml:name>ServerName</maml:name>
          <command:parameterValue>String</command:parameterValue>
        </command:parameter>
        <command:parameter required="false">
          <maml:name>RemoteAddress</maml:name>
          <command:parameterValue>String</command:parameterValue>
        </command:parameter>
        <command:parameter required="false">
          <maml:name>RemotePort</maml:name>
          <command:parameterValue>Int32</command:parameterValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="true" position="0">
        <maml:name>ServerName</maml:name>
        <maml:description>
          <maml:para>DNS name or IP address of the SMB server.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter required="false">
        <maml:name>RemoteAddress</maml:name>
        <maml:description>
          <maml:para>Optional address override for the SMB server.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter required="false">
        <maml:name>RemotePort</maml:name>
        <maml:description>
          <maml:para>Optional SMB port override.</maml:para>
        </maml:description>
        <command:parameterValue>Int32</command:parameterValue>
      </command:parameter>
    </command:parameters>
    <command:examples>
      <command:example>
        <command:title>-------------------------- EXAMPLE 1 --------------------------</command:title>
        <maml:code>Connect-TBOSmbServer -ServerName corp1-web01.corp1.lab.home-labs.lol</maml:code>
        <maml:remarks>
          <maml:para>Connects to the SMB server.</maml:para>
        </maml:remarks>
      </command:example>
    </command:examples>
  </command:command>

  <command:command>
    <command:details>
      <command:name>Set-TBOSmbConnectOptions</command:name>
      <command:verb>Set</command:verb>
      <command:noun>TBOSmbConnectOptions</command:noun>
      <maml:description>
        <maml:para>Sets connection defaults used by the TBO.Smb2 provider and cmdlets. Supports dynamic parameters for SMB connection and credential options.</maml:para>
      </maml:description>
    </command:details>
    <command:syntax>
      <command:syntaxItem>
        <command:name>Set-TBOSmbConnectOptions</command:name>
        <command:parameter required="false" position="0">
          <maml:name>ServerName</maml:name>
          <command:parameterValue>String</command:parameterValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="false" position="0">
        <maml:name>ServerName</maml:name>
        <maml:description>
          <maml:para>Server name to scope the connection defaults. Omit to set global defaults.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>HostName</maml:name>
        <maml:description>
          <maml:para>Optional host name override used for SPN construction.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>RemotePort</maml:name>
        <maml:description>
          <maml:para>Override the SMB port.</maml:para>
        </maml:description>
        <command:parameterValue>Int32</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>NameResolveOptions</maml:name>
        <maml:description>
          <maml:para>Name resolution options for the SMB target.</maml:para>
        </maml:description>
        <command:parameterValue>NameResolverOptions</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>Capabilities</maml:name>
        <maml:description>
          <maml:para>SMB capabilities to advertise during negotiation.</maml:para>
        </maml:description>
        <command:parameterValue>Smb2Capabilities</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>EnforceVersionCompliance</maml:name>
        <maml:description>
          <maml:para>Require the server to negotiate one of the requested dialects.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>Dialects</maml:name>
        <maml:description>
          <maml:para>SMB dialects to offer during negotiation.</maml:para>
        </maml:description>
        <command:parameterValue>Smb2Dialect[]</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>SecurityMode</maml:name>
        <maml:description>
          <maml:para>SMB security mode to request.</maml:para>
        </maml:description>
        <command:parameterValue>Smb2SecurityMode</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>RequireSecureNegotiate</maml:name>
        <maml:description>
          <maml:para>Require secure negotiate when supported by the server.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>ClientGuid</maml:name>
        <maml:description>
          <maml:para>Override the SMB client GUID.</maml:para>
        </maml:description>
        <command:parameterValue>Guid</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>PreauthSaltLength</maml:name>
        <maml:description>
          <maml:para>Preauthentication salt length for SMB 3.1.1.</maml:para>
        </maml:description>
        <command:parameterValue>Int32</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>Ciphers</maml:name>
        <maml:description>
          <maml:para>Preferred SMB encryption ciphers.</maml:para>
        </maml:description>
        <command:parameterValue>Cipher[]</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>SigningAlgorithms</maml:name>
        <maml:description>
          <maml:para>Preferred SMB signing algorithms.</maml:para>
        </maml:description>
        <command:parameterValue>SigningAlgorithm[]</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>CompressionCapabilities</maml:name>
        <maml:description>
          <maml:para>SMB compression capabilities to advertise.</maml:para>
        </maml:description>
        <command:parameterValue>CompressionCaps</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>CompressionAlgorithms</maml:name>
        <maml:description>
          <maml:para>Preferred SMB compression algorithms.</maml:para>
        </maml:description>
        <command:parameterValue>CompressionAlgorithm[]</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>UserName</maml:name>
        <maml:description>
          <maml:para>User name for authentication.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>UserDomain</maml:name>
        <maml:description>
          <maml:para>Domain for authentication.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>Password</maml:name>
        <maml:description>
          <maml:para>Password for authentication.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>NtlmHash</maml:name>
        <maml:description>
          <maml:para>Hex-encoded NTLM hash for authentication.</maml:para>
        </maml:description>
        <command:parameterValue>HexString</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>Kdc</maml:name>
        <maml:description>
          <maml:para>Override the Kerberos KDC host.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>KdcPort</maml:name>
        <maml:description>
          <maml:para>Override the Kerberos KDC port.</maml:para>
        </maml:description>
        <command:parameterValue>Int32</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>Workstation</maml:name>
        <maml:description>
          <maml:para>Workstation name for NTLM authentication.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
    </command:parameters>
    <command:examples>
      <command:example>
        <command:title>-------------------------- EXAMPLE 1 --------------------------</command:title>
        <maml:code>Set-TBOSmbConnectOptions -ServerName corp1-web01.corp1.lab.home-labs.lol -UserName psx_l_backupop -UserDomain corp1.lab.home-labs.lol -Password 'YourSecurePassword'</maml:code>
        <maml:remarks>
          <maml:para>Sets connection defaults for a specific server.</maml:para>
        </maml:remarks>
      </command:example>
    </command:examples>
  </command:command>

  <command:command>
    <command:details>
      <command:name>Copy-TBOSmbItem</command:name>
      <command:verb>Copy</command:verb>
      <command:noun>TBOSmbItem</command:noun>
      <maml:description>
        <maml:para>Copies files between local paths and SMB paths using backup intent.</maml:para>
      </maml:description>
    </command:details>
    <command:syntax>
      <command:syntaxItem>
        <command:name>Copy-TBOSmbItem</command:name>
        <command:parameter required="true" position="0">
          <maml:name>Source</maml:name>
          <command:parameterValue>String</command:parameterValue>
        </command:parameter>
        <command:parameter required="true" position="1">
          <maml:name>Destination</maml:name>
          <command:parameterValue>String</command:parameterValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="true" position="0">
        <maml:name>Source</maml:name>
        <maml:description>
          <maml:para>Source path. Accepts UNC paths, TBO.Smb2 PSDrive paths, or local paths.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter required="true" position="1">
        <maml:name>Destination</maml:name>
        <maml:description>
          <maml:para>Destination path. Accepts UNC paths, TBO.Smb2 PSDrive paths, or local paths.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>Force</maml:name>
        <maml:description>
          <maml:para>Overwrite the destination if it already exists. Alias: Overwrite.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>CreateDirectories</maml:name>
        <maml:description>
          <maml:para>Create destination directories when needed.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>PreserveTimestamps</maml:name>
        <maml:description>
          <maml:para>Preserve timestamps when copying.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>PreserveSecurityDescriptor</maml:name>
        <maml:description>
          <maml:para>Preserve security descriptors for SMB-to-SMB copies.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>ChunkSize</maml:name>
        <maml:description>
          <maml:para>Copy chunk size in bytes.</maml:para>
        </maml:description>
        <command:parameterValue>Int32</command:parameterValue>
      </command:parameter>
    </command:parameters>
    <command:examples>
      <command:example>
        <command:title>-------------------------- EXAMPLE 1 --------------------------</command:title>
        <maml:code>Copy-TBOSmbItem -Source tbo:\Windows\System32\config\SAM -Destination C:\Temp\SAM.bak</maml:code>
        <maml:remarks>
          <maml:para>Copies a remote file to the local machine.</maml:para>
        </maml:remarks>
      </command:example>
    </command:examples>
  </command:command>

  <command:command>
    <command:details>
      <command:name>Get-TBOSmbSecurityDescriptor</command:name>
      <command:verb>Get</command:verb>
      <command:noun>TBOSmbSecurityDescriptor</command:noun>
      <maml:description>
        <maml:para>Reads a security descriptor from a remote file or directory.</maml:para>
      </maml:description>
    </command:details>
    <command:syntax>
      <command:syntaxItem>
        <command:name>Get-TBOSmbSecurityDescriptor</command:name>
        <command:parameter required="true" position="0">
          <maml:name>Path</maml:name>
          <command:parameterValue>String[]</command:parameterValue>
        </command:parameter>
        <command:parameter required="false">
          <maml:name>AsSddl</maml:name>
          <command:parameterValue>Switch</command:parameterValue>
        </command:parameter>
        <command:parameter required="false">
          <maml:name>AsBytes</maml:name>
          <command:parameterValue>Switch</command:parameterValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="true" position="0">
        <maml:name>Path</maml:name>
        <maml:description>
          <maml:para>Target path. Accepts UNC paths or TBO.Smb2 PSDrive paths.</maml:para>
        </maml:description>
        <command:parameterValue>String[]</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>LiteralPath</maml:name>
        <maml:description>
          <maml:para>Literal target path. Use when the path contains wildcard characters.</maml:para>
        </maml:description>
        <command:parameterValue>String[]</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>AsSddl</maml:name>
        <maml:description>
          <maml:para>Return the security descriptor as an SDDL string.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>AsBytes</maml:name>
        <maml:description>
          <maml:para>Return the security descriptor as a byte array.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
    </command:parameters>
    <command:examples>
      <command:example>
        <command:title>-------------------------- EXAMPLE 1 --------------------------</command:title>
        <maml:code>Get-TBOSmbSecurityDescriptor -Path tbo:\Windows</maml:code>
        <maml:remarks>
          <maml:para>Reads the security descriptor from a directory.</maml:para>
        </maml:remarks>
      </command:example>
    </command:examples>
  </command:command>

  <command:command>
    <command:details>
      <command:name>Set-TBOSmbSecurityDescriptor</command:name>
      <command:verb>Set</command:verb>
      <command:noun>TBOSmbSecurityDescriptor</command:noun>
      <maml:description>
        <maml:para>Writes a security descriptor to a remote file or directory.</maml:para>
      </maml:description>
    </command:details>
    <command:syntax>
      <command:syntaxItem>
        <command:name>Set-TBOSmbSecurityDescriptor</command:name>
        <command:parameter required="true" position="0">
          <maml:name>Path</maml:name>
          <command:parameterValue>String[]</command:parameterValue>
        </command:parameter>
        <command:parameter required="true" position="1">
          <maml:name>SecurityDescriptor</maml:name>
          <command:parameterValue>SecurityDescriptor</command:parameterValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="true" position="0">
        <maml:name>Path</maml:name>
        <maml:description>
          <maml:para>Target path. Accepts UNC paths or TBO.Smb2 PSDrive paths.</maml:para>
        </maml:description>
        <command:parameterValue>String[]</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>LiteralPath</maml:name>
        <maml:description>
          <maml:para>Literal target path. Use when the path contains wildcard characters.</maml:para>
        </maml:description>
        <command:parameterValue>String[]</command:parameterValue>
      </command:parameter>
      <command:parameter required="true" position="1">
        <maml:name>SecurityDescriptor</maml:name>
        <maml:description>
          <maml:para>Security descriptor to write.</maml:para>
        </maml:description>
        <command:parameterValue>SecurityDescriptor</command:parameterValue>
      </command:parameter>
    </command:parameters>
    <command:examples>
      <command:example>
        <command:title>-------------------------- EXAMPLE 1 --------------------------</command:title>
        <maml:code>$sd = Get-TBOSmbSecurityDescriptor -Path tbo:\Windows
Set-TBOSmbSecurityDescriptor -Path tbo:\Windows -SecurityDescriptor $sd</maml:code>
        <maml:remarks>
          <maml:para>Reads and then writes a security descriptor.</maml:para>
        </maml:remarks>
      </command:example>
    </command:examples>
  </command:command>

  <command:command>
    <command:details>
      <command:name>Get-TBORegKey</command:name>
      <command:verb>Get</command:verb>
      <command:noun>TBORegKey</command:noun>
      <maml:description>
        <maml:para>Gets metadata for a remote registry key.</maml:para>
      </maml:description>
    </command:details>
    <command:syntax>
      <command:syntaxItem>
        <command:name>Get-TBORegKey</command:name>
        <command:parameter required="true" position="0">
          <maml:name>ServerName</maml:name>
          <command:parameterValue>String</command:parameterValue>
        </command:parameter>
        <command:parameter required="true" position="1">
          <maml:name>Path</maml:name>
          <command:parameterValue>String</command:parameterValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="true" position="0">
        <maml:name>ServerName</maml:name>
        <maml:description>
          <maml:para>Remote host name.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter required="true" position="1">
        <maml:name>Path</maml:name>
        <maml:description>
          <maml:para>Registry key path starting with a root key (for example, HKLM\SOFTWARE).</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
    </command:parameters>
    <command:examples>
      <command:example>
        <command:title>-------------------------- EXAMPLE 1 --------------------------</command:title>
        <maml:code>Get-TBORegKey -ServerName corp1-web01.corp1.lab.home-labs.lol -Path HKLM\SOFTWARE</maml:code>
        <maml:remarks>
          <maml:para>Gets key metadata from the remote registry.</maml:para>
        </maml:remarks>
      </command:example>
    </command:examples>
  </command:command>

  <command:command>
    <command:details>
      <command:name>Get-TBORegChildItem</command:name>
      <command:verb>Get</command:verb>
      <command:noun>TBORegChildItem</command:noun>
      <maml:description>
        <maml:para>Lists subkeys and values beneath a remote registry key.</maml:para>
      </maml:description>
    </command:details>
    <command:syntax>
      <command:syntaxItem>
        <command:name>Get-TBORegChildItem</command:name>
        <command:parameter required="true" position="0">
          <maml:name>ServerName</maml:name>
          <command:parameterValue>String</command:parameterValue>
        </command:parameter>
        <command:parameter required="true" position="1">
          <maml:name>Path</maml:name>
          <command:parameterValue>String</command:parameterValue>
        </command:parameter>
        <command:parameter required="false">
          <maml:name>IncludeSubkeys</maml:name>
          <command:parameterValue>Switch</command:parameterValue>
        </command:parameter>
        <command:parameter required="false">
          <maml:name>IncludeValues</maml:name>
          <command:parameterValue>Switch</command:parameterValue>
        </command:parameter>
        <command:parameter required="false">
          <maml:name>IncludeData</maml:name>
          <command:parameterValue>Switch</command:parameterValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="true" position="0">
        <maml:name>ServerName</maml:name>
        <maml:description>
          <maml:para>Remote host name.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter required="true" position="1">
        <maml:name>Path</maml:name>
        <maml:description>
          <maml:para>Registry key path to enumerate.</maml:para>
        </maml:description>
        <command:parameterValue>String</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>IncludeSubkeys</maml:name>
        <maml:description>
          <maml:para>Include subkeys. If neither IncludeSubkeys nor IncludeValues is specified, both are included.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>IncludeValues</maml:name>
        <maml:description>
          <maml:para>Include values. If neither IncludeSubkeys nor IncludeValues is specified, both are included.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
      <command:parameter>
        <maml:name>IncludeData</maml:name>
        <maml:description>
          <maml:para>Include value data when enumerating values.</maml:para>
        </maml:description>
        <command:parameterValue>Switch</command:parameterValue>
      </command:parameter>
    </command:parameters>
    <command:examples>
      <command:example>
        <command:title>-------------------------- EXAMPLE 1 --------------------------</command:title>
        <maml:code>Get-TBORegChildItem -ServerName corp1-web01.corp1.lab.home-labs.lol -Path HKLM\SOFTWARE</maml:code>
        <maml:remarks>
          <maml:para>Lists subkeys and values under the key.</maml:para>
        </maml:remarks>
      </command:example>
      <command:example>
        <command:title>-------------------------- EXAMPLE 2 --------------------------</command:title>
        <maml:code>Get-TBORegChildItem -ServerName corp1-web01.corp1.lab.home-labs.lol -Path HKLM\SOFTWARE -IncludeValues -IncludeData</maml:code>
        <maml:remarks>
          <maml:para>Lists values and includes data payloads.</maml:para>
        </maml:remarks>
      </command:example>
    </command:examples>
  </command:command>

  <command:command>
    <command:details>
      <command:name>New-TBORegKey</command:name>
      <command:verb>New</command:verb>
      <command:noun>TBORegKey</command:noun>
      <maml:description>
        <maml:para>Creates a remote registry key.</maml:para>
      </maml:description>
    </command:details>
    <command:syntax>
      <command:syntaxItem>
        <command:name>New-TBORegKey</command:name>
        <command:parameter required="true" position="0">
          <maml:name>ServerName</maml:name>
          <command:parameterValue>String</command:parameterValue>
        </command:parameter>
